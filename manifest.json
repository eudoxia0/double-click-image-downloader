{
  "manifest_version": 2,
  "name": "Double-Click Image Downloader",
  "developer": {
    "name": "Fernando Borretti",
    "url": "https://borretti.me/"
  },
  "homepage_url": "https://github.com/eudoxia0/double-click-image-downloader",
  "version": "1.1",
  "description": "Download images by double-clicking them.",
  "permissions": ["downloads", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "48": "icon.png",
    "96": "icon.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
